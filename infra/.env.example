# micromarket Docker Compose environment
#
# Copy this file to infra/.env before running Docker Compose:
#
#   cp infra/.env.example infra/.env
#
# Do not commit infra/.env.

# Shared
MICROMARKET_ENV=local

# API
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://micromarket:micromarket@db:5432/micromarket
ARTIFACT_ROOT=/app/data
CORS_ORIGINS=http://localhost:3000
MARKET_LOOKBACK_DAYS=30

# Sentiment provider selection:
# - baseline: deterministic offline provider
# - ollama: optional local LLM provider through Ollama /api/chat
SENTIMENT_PROVIDER=baseline
SENTIMENT_PROVIDER_FALLBACK=baseline

# If Docker Compose API talks to Ollama running on the host with Docker Desktop,
# use http://host.docker.internal:11434/api.
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_SENTIMENT_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=30

# Web
NEXT_PUBLIC_APP_NAME=micromarket
MICROMARKET_API_BASE_URL=http://localhost:8000

# Optional providers
OPENAI_API_KEY=
